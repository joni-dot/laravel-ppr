#!/usr/bin/env bash
# Docker Desktop sometimes misses a quick file edit, so the app keeps running an old copy of the file.
# This compares files on the host with the copy the container sees.
#
#   bin/sync-check [--fix] [files...]   without files: every changed or new file in git
#
# --fix writes each differing file again in place (same content), which makes Docker notice it.
# If a file still differs after that, run `sail down` and `sail up -d`, but only when no other agent
# is using the containers.
set -euo pipefail
shopt -s inherit_errexit

cd "$(dirname "$0")/.."

fix=false
if [ "${1:-}" = '--fix' ]; then
    fix=true
    shift
fi

files=("$@")
if [ ${#files[@]} -eq 0 ]; then
    # Changed, staged and new files; deleted ones have nothing to compare.
    while IFS= read -r -d '' file; do
        [ -f "$file" ] && files+=("$file")
    done < <(git ls-files -z --modified --others --exclude-standard; git diff -z --name-only --cached)
fi

if [ ${#files[@]} -eq 0 ]; then
    echo 'No changed files to check.'
    exit 0
fi

mapfile -t files < <(printf '%s\n' "${files[@]}" | sort -u)

# Prints "<hash> <file>" for each file inside the container, in one call.
container_hashes() {
    docker compose exec -T laravel.test sh -c 'cd /var/www/html && for f; do h=$(sha256sum -- "$f" 2>/dev/null | cut -d" " -f1); printf "%s %s\n" "${h:-missing}" "$f"; done' _ "$@"
}

differing() {
    local -A inside=()
    local hash file

    local hashes
    # Read into a variable first: a failure inside <(...) would be lost and look like "all match".
    hashes="$(container_hashes "$@")"

    while read -r hash file; do
        [ -n "$file" ] || continue
        inside["$file"]="$hash"
    done <<<"$hashes"

    for file in "$@"; do
        hash="$(sha256sum -- "$file" | cut -d' ' -f1)"
        [ "${inside[$file]:-missing}" = "$hash" ] || printf '%s\n' "$file"
    done
}

stale_list="$(differing "${files[@]}")"
mapfile -t stale < <(printf '%s' "$stale_list" | sed '/^$/d')

if [ ${#stale[@]} -eq 0 ]; then
    echo "All ${#files[@]} files match inside the container."
    exit 0
fi

printf 'Differs inside the container: %s\n' "${stale[@]}"

if [ "$fix" = false ]; then
    echo 'Run again with --fix to write them again.'
    exit 1
fi

for file in "${stale[@]}"; do
    # Rewriting through the same file (not replacing it) is what Docker notices.
    content="$(cat -- "$file"; printf x)"
    printf '%s' "${content%x}" >"$file"
done

sleep 1
still_list="$(differing "${stale[@]}")"
mapfile -t still < <(printf '%s' "$still_list" | sed '/^$/d')

if [ ${#still[@]} -eq 0 ]; then
    echo "Fixed: ${#stale[@]} files now match."
    exit 0
fi

printf 'Still differs: %s\n' "${still[@]}"
echo 'Run ./vendor/bin/sail down and then ./vendor/bin/sail up -d, when no other agent is using the containers.'
exit 1
